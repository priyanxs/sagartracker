# =========================================================================
# Sagar Attendance & Bunk Advisor Telegram Bot Configuration
# =========================================================================

# 1. Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Target Quota (Default 75%)
DEFAULT_TARGET_QUOTA=75.0

# 3. College / ERP Portal Configuration (MasterSoft CIMS / Student Direct Cloud)
DEFAULT_PORTAL_URL=https://cimsstudentnewui.mastersofterp.in
COLLEGE_NAME="Sagar Group of Institutions (SISTec)"

# 4. Logging & Diagnostics
LOG_LEVEL=INFO

# =========================================================================
# CampusMove — Supabase Environment Configuration (Optional)
# =========================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
PORT=5000
