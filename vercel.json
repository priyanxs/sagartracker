{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/transit", "destination": "/sagartracker.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
